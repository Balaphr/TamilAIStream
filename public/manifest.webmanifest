  "screenshots": [
    {
      "src": "/screenshots/home-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Tamil AI Stream Home - Live Tamil Radio"
    },
    {
      "src": "/screenshots/home-narrow.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tamil AI Stream Mobile - Live Radio & AI Recommendations"
    },
    {
      "src": "/screenshots/player-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
