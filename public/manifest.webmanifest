    },
    {
      "src": "/screenshots/player-narrow.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Now Playing - AI Recommendations & Lyrics"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Songs",
      "short_name": "Search",
      "url": "/?action=search",
      "description": "Search Tamil songs, movies, artists",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Live Radio",
      "short_name": "Radio",
      "url": "/?action=radio",
      "description": "Listen to live Tamil FM stations",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Favorites",
      "short_name": "Favorites",
      "url": "/?action=favorites",
      "description": "Your favorite songs and stations",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+tamilaistream",
      "url": "/?action=play&track=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  }
}